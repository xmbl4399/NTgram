<?xml version="1.0" encoding="utf-8"?>
<!-- Same Android 12+ splash for system dark mode. NTgram is a dark app so the
     launch background stays #0E1621; kept as a separate file so future
     light-mode splash tweaks don't touch the default. Animated icon omitted:
     the in-app AppSplashGate renders the uncropped centered logo. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ntgram_launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
