<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ SplashScreen API. windowSplashScreenBackground paints the
     full window #0E1621. The animated icon is intentionally NOT set: the OS
     SplashScreen would crop a full-bleed launcher image to its 1/3 safe zone,
     so the logo is shown instead by the in-app AppSplashGate on first frame
     (Nekogram-style flat color + centered mark, uncropped). -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/ntgram_launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
